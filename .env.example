# ==============================================================================
# Nascence Huiye - Docker & 环境配置模板 (.env.example)
# 使用方法：复制本文件为 .env 并按需填写，docker compose 会自动加载此文件：
#   cp .env.example .env
# ==============================================================================

# ---------- 端口配置 ----------
# Web 控制面板暴露端口（默认 32123）
PANEL_PORT=32123

# NapCat 反向 WebSocket 服务端口（默认 6700）
NAPCAT_PORT=6700

# ---------- QQ 接入配置 ----------
# 机器人 QQ 号码
BOT_QQ=123456789

# 默认主动发言的目标群号
ACTIVE_GROUP_ID=123456789

# NapCat 反向 WebSocket 连接鉴权 Token（必须与 NapCat 客户端配置一致）
NAPCAT_TOKEN=Nascence

# ---------- 大模型 (LLM) API 配置 ----------
# 主模型 API Key（用于认知理解与回复生成，如 DeepSeek / OpenAI 兼容接口）
PRIMARY_API_KEY=sk-your-primary-api-key-here

# 主模型 API 服务地址
PRIMARY_BASE_URL=https://api.deepseek.com

# 主模型名称
PRIMARY_MODEL=deepseek-v4-flash

# 多模态副模型 API Key（用于图片理解、表情包识别、音频与视频处理）
SECONDARY_API_KEY=sk-your-secondary-api-key-here

# 多模态副模型 API 服务地址
SECONDARY_BASE_URL=https://api.deepseek.com

# 多模态副模型名称
SECONDARY_MODEL=deepseek-v4-flash-vision-exp

# ---------- 本地 Ollama 嵌入模型配置 ----------
# 容器内访问宿主机 Ollama（Docker 默认通过 host.docker.internal 连通宿主机）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 向量嵌入模型（需先在宿主机执行: ollama pull shaw/dmeta-embedding-zh）
OLLAMA_EMBED_MODEL=shaw/dmeta-embedding-zh

# ---------- 容器环境覆盖开关 ----------
# 是否强制用 .env 环境变量覆盖 api_config.json 中的历史配置（1=强制覆盖，0=仅在配置为默认占位符时补充）
HUIYE_ENV_OVERRIDE=0
