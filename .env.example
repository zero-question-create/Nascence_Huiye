# ==============================================================================
# Nascence Huiye - Docker 端口环境配置 (.env.example)
# 使用方法：复制本文件为 .env：
#   cp .env.example .env
#
# 说明：
# 本项目的所有大模型（主模型/次模型）、向量嵌入（Ollama）、QQ Bot（NapCat）
# 等业务配置均已全面收敛至 Web 控制面板中可视化管理与实时热更新，
# 保存后自动持久化在挂载的 config/ 卷中，无需在 .env 中繁琐配置。
# .env 仅需配置容器与宿主机的端口映射。
# ==============================================================================

# Web 控制面板访问端口（宿主机端口映射，默认 32123）
PANEL_PORT=32123

# NapCat 反向 WebSocket 连接端口（宿主机端口映射，默认 6700）
NAPCAT_PORT=6700
