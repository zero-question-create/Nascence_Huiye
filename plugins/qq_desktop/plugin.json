{
  "id": "qq_desktop",
  "name": "QQ（桌面读取）",
  "version": "1.0.0",
  "api_version": 1,
  "min_host_version": "0.9.0",
  "kind": "app",
  "entry": "plugin.py:PLUGIN",
  "panel": "panel.py:PANEL",
  "capabilities": ["chat", "group_chat"],
  "platforms": ["windows"],
  "permissions": ["desktop.uia", "screen.capture"],
  "dependencies": ["desktop"],
  "description": "不登录 QQ 协议，直接读已打开的 QQ 窗口；未读来自窗口里的“N条未读”。",
  "readme": "README.md",
  "author": "Nascence",
  "homepage": "https://github.com/zero-question-create/nhy-plugin-qq-desktop",
  "license": "MIT",
  "source": "https://github.com/zero-question-create/nhy-plugin-qq-desktop"
}
